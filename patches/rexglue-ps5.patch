diff --git a/include/rex/platform_ps5.h b/include/rex/platform_ps5.h
new file mode 100644
index 0000000..245410f
--- /dev/null
+++ b/include/rex/platform_ps5.h
@@ -0,0 +1,22 @@
+/**
+ * reEye: PS5 compatibility for ReXGlue's POSIX (Linux) code paths.
+ *
+ * The PS5 is FreeBSD-based: off_t is always 64-bit (no *64 variants), there is no CLOCK_MONOTONIC_RAW, and a thread
+ * id comes from pthread_getthreadid_np(). Included at the end of rex/platform.h when REX_PLATFORM_PS5.
+ */
+#pragma once
+
+#if REX_PLATFORM_PS5
+
+#define ftruncate64 ftruncate
+#define mmap64 mmap
+#define fstat64 fstat
+#define stat64 stat
+#define lseek64 lseek
+#define fseeko64 fseeko
+#define ftello64 ftello
+#define fopen64 fopen
+#define off64_t off_t
+#define CLOCK_MONOTONIC_RAW CLOCK_MONOTONIC
+
+#endif  // REX_PLATFORM_PS5
