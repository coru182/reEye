+/**
+ * reEye: the PS5's one display (VideoOut). The Vulkan presenter makes it a VK_KHR_display plane surface on RADV;
+ * the size is the display mode the PS5 host chose.
+ */
+#pragma once
+
+#include <cstdint>
+
+#include <rex/ui/surface.h>
+
+namespace rex::ui {
+
+class Ps5DisplaySurface final : public Surface {
+ public:
+  Ps5DisplaySurface(uint32_t width, uint32_t height) : width_(width), height_(height) {}
+  TypeIndex GetType() const override { return kTypeIndex_Ps5Display; }
+
+ protected:
+  bool GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const override {
+    width_out = width_;
+    height_out = height_;
+    return true;
+  }
+
+ private:
+  uint32_t width_;
+  uint32_t height_;
+};
+
+}  // namespace rex::ui
