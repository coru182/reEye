+#if REX_PLATFORM_PS5
+      case Surface::kTypeIndex_Ps5Display: {
+        // reEye: VideoOut's display through VK_KHR_display, as reKing (and reUndr's SDL_ps5vulkan.c, MIT,
+        // bystritskiy) do: the display's mode closest to the surface's size, on the first plane that shows it.
+        vulkan_surface_create_result = VK_ERROR_INITIALIZATION_FAILED;
+        const VkPhysicalDevice gpu = vulkan_device_->physical_device();
+        uint32_t display_count = 0;
+        ifn.vkGetPhysicalDeviceDisplayPropertiesKHR(gpu, &display_count, nullptr);
+        std::vector<VkDisplayPropertiesKHR> displays(display_count);
+        if (display_count) {
+          ifn.vkGetPhysicalDeviceDisplayPropertiesKHR(gpu, &display_count, displays.data());
+        }
+        if (!display_count) {
+          REXLOG_ERROR("VulkanPresenter: VideoOut has no display");
+          break;
+        }
+        const VkDisplayKHR display = displays[0].display;
+        uint32_t mode_count = 0;
+        ifn.vkGetDisplayModePropertiesKHR(gpu, display, &mode_count, nullptr);
+        std::vector<VkDisplayModePropertiesKHR> modes(mode_count);
+        if (mode_count) {
+          ifn.vkGetDisplayModePropertiesKHR(gpu, display, &mode_count, modes.data());
+        }
+        if (!mode_count) {
+          REXLOG_ERROR("VulkanPresenter: VideoOut has no display modes");
+          break;
+        }
+        size_t best_mode = 0;
+        uint64_t best_distance = UINT64_MAX;
+        for (size_t i = 0; i < modes.size(); ++i) {
+          const VkExtent2D& extent = modes[i].parameters.visibleRegion;
+          const int64_t dw = int64_t(extent.width) - int64_t(new_surface_width);
+          const int64_t dh = int64_t(extent.height) - int64_t(new_surface_height);
+          const uint64_t distance = uint64_t(dw * dw + dh * dh);
+          if (distance < best_distance) {
+            best_distance = distance;
+            best_mode = i;
+          }
+        }
+        const VkDisplayModePropertiesKHR& mode = modes[best_mode];
+        uint32_t plane_count = 0;
+        ifn.vkGetPhysicalDeviceDisplayPlanePropertiesKHR(gpu, &plane_count, nullptr);
+        int plane = -1;
+        for (uint32_t i = 0; i < plane_count && plane < 0; ++i) {
+          uint32_t supported_count = 0;
+          if (ifn.vkGetDisplayPlaneSupportedDisplaysKHR(gpu, i, &supported_count, nullptr) != VK_SUCCESS ||
+              !supported_count) {
+            continue;
+          }
+          std::vector<VkDisplayKHR> supported(supported_count);
+          ifn.vkGetDisplayPlaneSupportedDisplaysKHR(gpu, i, &supported_count, supported.data());
+          for (VkDisplayKHR d : supported) {
+            if (d == display) {
+              plane = int(i);
+              break;
+            }
+          }
+        }
+        if (plane < 0) {
+          REXLOG_ERROR("VulkanPresenter: no plane shows VideoOut's display");
+          break;
+        }
+        VkDisplayPlaneCapabilitiesKHR plane_caps = {};
+        ifn.vkGetDisplayPlaneCapabilitiesKHR(gpu, mode.displayMode, uint32_t(plane), &plane_caps);
+        VkDisplaySurfaceCreateInfoKHR surface_create_info = {};
+        surface_create_info.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR;
+        surface_create_info.displayMode = mode.displayMode;
+        surface_create_info.planeIndex = uint32_t(plane);
+        surface_create_info.planeStackIndex = 0;
+        surface_create_info.transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+        surface_create_info.globalAlpha = 1.0f;
+        surface_create_info.alphaMode =
+            (plane_caps.supportedAlpha & VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR)
+                ? VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR
+                : VK_DISPLAY_PLANE_ALPHA_GLOBAL_BIT_KHR;
+        surface_create_info.imageExtent = mode.parameters.visibleRegion;
+        vulkan_surface_create_result = ifn.vkCreateDisplayPlaneSurfaceKHR(
+            instance, &surface_create_info, nullptr, &paint_context_.vulkan_surface);
+        REXLOG_INFO("VulkanPresenter: VideoOut {}x{} at {}.{:03} Hz, plane {}",
+                    surface_create_info.imageExtent.width, surface_create_info.imageExtent.height,
+                    mode.parameters.refreshRate / 1000, mode.parameters.refreshRate % 1000, plane);
+      } break;
 #endif
       default:
         assert_unhandled_case(surface_type);
